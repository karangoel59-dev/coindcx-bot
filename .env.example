# ---------------------------------------------------------------------------
# CoinDCX credentials
# Create at https://coindcx.com/api-dashboard
# TRADING PERMISSION ONLY. Never enable withdrawals. Whitelist this host's IP.
# ---------------------------------------------------------------------------
COINDCX_API_KEY=
COINDCX_API_SECRET=

# ---------------------------------------------------------------------------
# Mode
#   paper -> orders are routed to the SDK's in-memory engine, nothing is sent
#   live  -> orders reach CoinDCX
# `npm run paper` / `npm run live` set this for you.
# ---------------------------------------------------------------------------
MODE=paper

# DRY_RUN=true logs the order it *would* place and skips submission entirely.
# Works in live mode too — use it for the first run against real keys.
DRY_RUN=true

# ---------------------------------------------------------------------------
# Instrument
# CoinDCX futures pairs are exchange-prefixed: B-BTC_USDT, B-SOL_USDT, ...
# ---------------------------------------------------------------------------
BASE_CURRENCY=BTC
QUOTE_CURRENCY=USDT
CANDLE_INTERVAL=15m

# ---------------------------------------------------------------------------
# Risk — all of these are enforced before an order is built
# ---------------------------------------------------------------------------
LEVERAGE=3
MARGIN_TYPE=isolated
# Fraction of account equity risked between entry and stop, per trade.
RISK_PERCENT=0.5
# Stop distance as a fraction of entry price (0.015 = 1.5%).
STOP_LOSS_PCT=0.015
# Take-profit distance as a fraction of entry price. Blank = no TP.
TAKE_PROFIT_PCT=0.03

# Broker quantity cap and notional budget checked at the executable quote.
# Market fills may exceed the estimated notional during a price jump.
# Set at least one. These are your blast radius.
MAX_ORDER_QUANTITY=0.01
MAX_ORDER_NOTIONAL=500
# Allowance applied to executable quote when checking the notional budget.
# Market fills can move beyond this estimate; this is not an exchange price limit.
MAX_SLIPPAGE_PCT=0.005

# Engine-side backstop: if mark price overshoots the stop by this fraction
# while the position is still open on the venue, flatten at market.
STOP_OVERRUN_TOLERANCE=0.1

# ---------------------------------------------------------------------------
# Paper engine (ignored in live mode)
# ---------------------------------------------------------------------------
PAPER_BALANCE=10000
PAPER_TAKER_FEE=0.0005
PAPER_SLIPPAGE=0.0005

# ---------------------------------------------------------------------------
# Monitoring UI
# Served by the bot at http://127.0.0.1:<port>. Binds to loopback only — it
# exposes positions and balances, so don't expose it to the network; tunnel
# over SSH if you need it from another machine. Set to 0 to disable.
# ---------------------------------------------------------------------------
DASHBOARD_PORT=8787

# ---------------------------------------------------------------------------
# Strategy
#
#   ema-cross          fast/slow EMA crossover. Long or flat.
#   donchian-breakout  Turtle-style channel breakout. Trend following:
#                      low win rate, long flat spells, rare large winners.
#   supertrend         ATR-banded trend following. Always in the market when
#                      shorts are on, so it pays the most in fees.
#   rsi2-reversion     Connors RSI(2) with a 200-SMA trend filter. Mean
#                      reversion: in the market only ~5% of the time.
#   macd-trend         MACD signal cross, optional SMA filter.
#   trend-vote         20/60/120-bar momentum vote. Long or flat by default.
#                      For 1d candles with a wide stop; backtested (README).
#   always-long        plumbing test. Refuses to run live.
#
# Only trend-vote has been backtested here (see README). The rest are correctly implemented and
# unit-tested, which is not the same as profitable.
# ---------------------------------------------------------------------------
STRATEGY=ema-cross

# Allow strategies that can take both sides to go short. Off by default: a
# short pays funding and adds a whole second set of ways to be wrong.
# Strategies that would short go flat instead while this is false.
# (ema-cross is long/flat by design and ignores this.)
ALLOW_SHORTS=false

# --- donchian-breakout ---
# Entry channel is the wide one, exit channel the tighter one (Turtle 20/10).
DONCHIAN_ENTRY_PERIOD=20
DONCHIAN_EXIT_PERIOD=10

# --- supertrend ---
# Lower multiplier = tighter bands = far more whipsaw.
SUPERTREND_PERIOD=10
SUPERTREND_MULTIPLIER=3

# --- rsi2-reversion ---
# Connors' published rules. Sources differ on the entry threshold (10 vs 5).
# The trend SMA is the whole strategy — without it this buys every rung of a
# downtrend. Needs > RSI_TREND_SMA_PERIOD warmup candles.
RSI_PERIOD=2
RSI_OVERSOLD=10
RSI_OVERBOUGHT=90
RSI_TREND_SMA_PERIOD=200
RSI_EXIT_SMA_PERIOD=5

# --- macd-trend ---
# MACD_TREND_SMA_PERIOD=0 disables the filter (textbook MACD). Setting it to
# e.g. 200 suppresses counter-trend crosses, the usual improvement.
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
MACD_TREND_SMA_PERIOD=0
# --- trend-vote ---
# Multi-horizon time-series momentum. Each lookback votes on whether the close
# is above the close that many bars ago. 'all' enters only when every lookback
# agrees; either way the position is held until the majority is lost.
# Designed for CANDLE_INTERVAL=1d with STOP_LOSS_PCT around 0.2 and no
# TAKE_PROFIT_PCT — a tight stop or a take-profit turns it into a fee machine
# (see README). Needs WARMUP_CANDLES > the largest lookback.
TREND_VOTE_LOOKBACKS=20,60,120
TREND_VOTE_ENTRY=all

EMA_FAST=9
EMA_SLOW=21
# Candles pulled on boot to seed the EMAs.
WARMUP_CANDLES=250
