{
  "name": "coindcx-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CoinDCX futures automation: target-position engine on @nemesis-oss/coindcx-sdk",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preflight": "tsx --env-file-if-exists=.env src/scripts/preflight.ts",
    "recover-entry": "tsx --env-file-if-exists=.env src/scripts/recover-entry.ts",
    "smoke": "MODE=paper DRY_RUN=false tsx --env-file-if-exists=.env src/scripts/smoke.ts",
    "paper": "MODE=paper tsx --env-file-if-exists=.env src/index.ts",
    "live": "MODE=live tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@nemesis-oss/coindcx-sdk": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
